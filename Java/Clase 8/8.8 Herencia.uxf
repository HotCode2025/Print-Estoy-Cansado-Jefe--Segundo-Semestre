+setVip(boolean): void</panel_attributes>
  </element>

  <!-- Herencia Empleado -> Persona -->
  <element>
    <id>UMLGeneralization</id>
    <coordinates>
      <x>210</x>
      <y>240</y>
      <w>220</w>
      <h>120</h>
