<?xml version="1.0" encoding="UTF-8"?>
<diagram program="umlet" version="14.2">
  <element>
    <id>UMLClass</id>
    <coordinates>
      <x>300</x>
      <y>40</y>
      <w>260</w>
      <h>260</h>
    </coordinates>
    <panel_attributes>Persona
--
-nombre: String
-genero: char
-edad: int
-direccion: String
--
