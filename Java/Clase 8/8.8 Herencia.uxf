+setNombre(String): void
+getGenero(): char
+setGenero(char): void
+getEdad(): int
+setEdad(int): void
+getDireccion(): String
+setDireccion(String): void</panel_attributes>
  </element>

  <element>
    <id>UMLClass</id>
    <coordinates>
      <x>60</x>
      <y>320</y>
      <w>260</w>
      <h>200</h>
    </coordinates>
    <panel_attributes>Empleado
--
-idEmpleado: int
-sueldo: double
--
+getIdEmpleado(): int
+getSueldo(): double
+setSueldo(double): void</panel_attributes>
  </element>

  <element>
    <id>UMLClass</id>
    <coordinates>
      <x>540</x>
      <y>320</y>
      <w>260</w>
      <h>220</h>
    </coordinates>
    <panel_attributes>Cliente
--
-idCliente: int
-fechaRegistro: Date
